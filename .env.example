# Configuração do banco no AWS RDS (substitua pelo endpoint real)
DB_URL=jdbc:mysql://your-rds-endpoint.rds.amazonaws.com:3306/tem_na_festa?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC&useUnicode=true&characterEncoding=UTF-8
DB_USER=tem_na_festa_user
DB_PASSWORD=change_me_to_a_strong_password

# Configuração da aplicação
JWT_SECRET=change_me_to_a_long_random_secret_32_chars_minimum
PORT=8080

